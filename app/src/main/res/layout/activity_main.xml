<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:layout_marginTop="70dp"
    android:background="@color/background"
    tools:context=".activity.MainActivity">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản Lý Sân Bóng"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/button_field_management"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quản lý sân bóng"
        android:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/button_service_management"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quản lý dịch vụ"
        android:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/button_field_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/button_booking_management"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quản lý lịch đặt sân"
        android:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/button_service_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/button_statistics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Thống kê"
        android:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/button_booking_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/button_help"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Trợ giúp"
        android:backgroundTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/button_statistics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/button_logout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Đăng xuất"
        android:backgroundTint="@color/secondary"
        app:layout_constraintTop_toBottomOf="@id/button_help"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>